{
  "name": "@kaijia/dsh-sidebar",
  "version": "0.1.4",
  "description": "VSCode-style file explorer for the DeepSeek Harness web client: a body-mounted, draggable right sidebar with virtualized lazy file tree and text / Markdown / image preview. Does not depend on the native details slot, so it works on blank sessions.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs",
    "prepare": "node build.mjs",
    "prepack": "node build.mjs",
    "test": "node build.mjs && node --test --test-isolation=none test/client-model.test.ts test/host-rpc.test.ts test/client-contract.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "animejs": "^4.5.0",
    "chokidar": "^3.6.0",
    "lucide-react": "^1.33.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "rolldown": "1.0.0-rc.9",
    "tailwindcss": "^3.4.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
