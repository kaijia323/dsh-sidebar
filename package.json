{
  "name": "dsh-ymc-sidebar",
  "version": "0.1.0",
  "description": "VSCode-style file explorer for the DeepSeek Harness web client: virtualized, lazily loaded file tree in the right details column with text / Markdown / image preview.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs",
    "test": "node build.mjs && node --test --test-isolation=none test/client-model.test.ts test/host-rpc.test.ts test/client-contract.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "lucide-react": "^1.33.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "rolldown": "1.0.0-rc.9",
    "tailwindcss": "^3.4.17"
  },
  "license": "MIT"
}
